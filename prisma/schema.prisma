datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────────────────────────────────────────────────────────
// NOTE: User authentication is handled by Supabase Auth.
// Users are stored in Supabase's auth.users table — not here.
// All business models reference userId as a plain String (UUID from auth.users).
// ─────────────────────────────────────────────────────────────────────────────

model Semester {
  id               String            @id @default(uuid())
  userId           String            // references auth.users.id
  name             String
  startDate        DateTime
  endDate          DateTime
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  subjects         Subject[]

  @@index([userId])
  @@index([userId, isActive])
}

model Subject {
  id               String            @id @default(uuid())
  userId           String            // references auth.users.id
  semesterId       String
  semester         Semester          @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  name             String
  code             String?
  color            String            @default("#6366f1")
  targetPercentage Float             @default(75.0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  timetableSlots   TimetableSlot[]
  lectureInstances LectureInstance[]

  @@index([userId])
  @@index([userId, semesterId])
  @@index([userId, semesterId, name])
}

model TimetableSlot {
  id               String            @id @default(uuid())
  userId           String            // references auth.users.id
  subjectId        String
  subject          Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  dayOfWeek        Int               // 1 = Monday … 6 = Saturday, 0 = Sunday
  startTime        String            // "09:00"
  endTime          String            // "10:00"
  room             String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  lectureInstances LectureInstance[]

  @@index([userId])
  @@index([userId, isActive])
  @@index([userId, dayOfWeek])
  @@index([userId, dayOfWeek, isActive])
  @@index([subjectId, dayOfWeek])
}

model LectureInstance {
  id               String         @id @default(uuid())
  userId           String         // references auth.users.id
  subjectId        String
  subject          Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  timetableSlotId  String?
  timetableSlot    TimetableSlot? @relation(fields: [timetableSlotId], references: [id], onDelete: SetNull)
  date             DateTime
  startTime        String         @default("09:00")
  endTime          String         @default("10:00")
  status           String         @default("SCHEDULED") // "SCHEDULED", "ATTENDED", "MISSED", "HOLIDAY"
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([subjectId, date, startTime], name: "subject_date_time_unique")
  @@index([userId])
  @@index([userId, date])
  @@index([userId, status])
  @@index([subjectId, date])
  @@index([timetableSlotId])
}
