# Use your cloud database connection string here. For the current SQLite schema, use a SQLite-compatible URL.
DATABASE_URL="file:./dev.db"

# SMTP provider settings used to send 6-digit email verification codes.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
SMTP_FROM="AttendIQ <no-reply@example.com>"

# Optional cookie name. Keep the default unless you have a conflict.
AUTH_COOKIE_NAME="attendiq_session"
